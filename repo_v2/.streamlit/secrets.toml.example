# Copy this file to .streamlit/secrets.toml for local development
# (that file is gitignored - never commit real secrets).
#
# On Streamlit Community Cloud, don't upload this file at all - instead
# paste the same three keys into your app's Settings -> Secrets in the
# dashboard. See README.md "Keeping the source data private" for the
# full setup, including how to create the token.

github_token = "github_pat_xxx"          # fine-grained PAT, Contents: Read-only, scoped to ONE repo
data_repo = "your-github-username/india-salary-data-private"
data_path = "india_salaries_deduped.csv"
